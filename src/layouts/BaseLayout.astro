---
export interface Props {
  title?: string;
  description?: string;
}
export let title: string | undefined;
export let description: string | undefined;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — Onaïa Savary` : 'Onaïa Savary'}</title>
    <meta name="description" content={description ?? 'Site personnel de doctorant en climatologie'} />
    <meta name="theme-color" content="#0d1b2a" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
