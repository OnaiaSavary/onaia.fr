---
import PageLayout from '../layouts/PageLayout.astro';

export interface Props {
  title: string;
  description: string;
  image: string;
  intro?: string;
  sectionIntro?: string;
}

const { title, description, image, intro, sectionIntro } = Astro.props;
---
<PageLayout {title} {description}>
  <div class="content-page">
    <header class="content-page-hero" style={`--page-hero-image: url('${image}')`}>
      <div class="inner">
        <h1>{title}</h1>
        {intro && <p>{intro}</p>}
      </div>
    </header>
    <section class="wrapper style5 content-page-body">
      <div class="inner">
        {sectionIntro && <p class="content-page-intro">{sectionIntro}</p>}
        <slot />
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .content-page-intro {
    max-width: 75ch;
    margin: 0 0 2rem;
    font-size: 1.05rem;
    line-height: 1.75;
  }
</style>
