---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('vulgarisation');
---
<PageLayout title="Vulgarisation">
  <div class="site-wrap">
    <section class="read-width">
      <h1>Vulgarisation</h1>
      <p>Articles de communication scientifique.</p>
      <div class="posts">
        {posts.sort((a,b)=> (b.data.date ?? '').localeCompare(a.data.date ?? '')).map(p => (
          <article class="post">
            <h3><a href={`/vulgarisation/${p.slug}/`}>{p.data.title}</a></h3>
            <p class="summary">{p.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
