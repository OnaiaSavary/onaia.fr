---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const pubs = await getCollection('publications');
---
<PageLayout title="Publications" description="Peer-reviewed publications by Onaïa Savary.">
  <div class="site-wrap">
    <section class="read-width">
      <h1>Publications</h1>
      <p>Peer-reviewed research, listed in chronological order.</p>
      <div class="publications">
        {pubs.sort((a,b)=>b.data.year - a.data.year).map(p => (
          <article id={p.slug} class="pub">
            <h3><a href={p.data.url ?? `https://doi.org/${p.data.doi}`} target="_blank" rel="noreferrer">{p.data.title}</a></h3>
            <div class="meta">{p.data.authors?.join(', ')} — <em>{p.data.journal}</em> ({p.data.year})</div>
            {p.data.published && <p>Published: {p.data.published}</p>}
            {p.data.doi && <p>DOI: <a href={`https://doi.org/${p.data.doi}`} target="_blank" rel="noreferrer">{p.data.doi}</a></p>}
          </article>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
