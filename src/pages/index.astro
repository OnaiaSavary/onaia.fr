---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const featured = await getCollection('publications');
---
<PageLayout title="Accueil" description="Page d'accueil">
  <div class="site-wrap">
    <section class="hero-hero">
      <div>
        <h1 class="hero-name fade-in">
          <span class="line1">ONAÏA</span>
          <span class="line2">SAVARY</span>
        </h1>
      </div>
      <div>
        <p class="hero-intro fade-in">Climatologue travaillant sur les sécheresses, la variabilité climatique et la circulation atmosphérique.</p>
        <p class="hero-topics fade-in">Sécheresses · Weather regimes · Changement climatique</p>
      </div>
    </section>

    <section class="read-width" style="margin-top:3rem">
      <h2>Publications en vedette</h2>
      <div>
        {featured.filter(p => p.data.featured).map(p => (
          <article class="publication-card">
            <h3>{p.data.title}</h3>
            <div class="meta">{p.data.authors?.join(', ')} — {p.data.year}</div>
          </article>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
