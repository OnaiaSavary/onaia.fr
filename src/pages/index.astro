---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const featured = await getCollection('publications');
---
<PageLayout title="Accueil" description="Doctorant en climatologie">
  <div class="site-wrap home-page-shell">
    <section
      class="home-hero"
      aria-label="Présentation de la recherche"
      style={`--hero-background-image: url('/images/home-backround.jpg'); --hero-background-position: center center;`}
    >
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Doctorant en climatologie</p>
          <h1 class="hero-name" aria-label="Onaïa Savary">
            <span>ONAÏA</span>
            <span>SAVARY</span>
          </h1>
          <p class="hero-intro">Je travaille sur la prévisibilité et l'évolution des sécheresses en Europe, en étudiant notamment le rôle de la circulation atmosphérique.</p>
        </div>
      </div>
    </section>

    <section class="editorial-section home-panels" aria-label="Accès aux différentes parties du site">
      <div class="section-label">Explorer le site</div>
      <div class="editorial-grid">
        <a class="editorial-card panel-link" href="/research/">
          <h3>Recherche</h3>
          <p>Prévisibilité des sécheresses, circulation atmosphérique et changement climatique en Europe.</p>
        </a>
        <a class="editorial-card panel-link" href="/publications/">
          <h3>Publications</h3>
          <p>Articles, travaux sélectionnés et contributions scientifiques.</p>
        </a>
        <a class="editorial-card panel-link" href="/conferences/">
          <h3>Conférences</h3>
          <p>Présentations et échanges autour des sciences du climat.</p>
        </a>
        <a class="editorial-card panel-link" href="/vulgarisation/">
          <h3>Vulgarisation</h3>
          <p>Articles pour rendre la recherche climatique plus accessible.</p>
        </a>
        <a class="editorial-card panel-link" href="/posters/">
          <h3>Posters</h3>
          <p>Supports visuels et synthèses de projets scientifiques.</p>
        </a>
        <a class="editorial-card panel-link" href="/cv/">
          <h3>Curriculum vitae</h3>
          <p>Parcours académique, expériences et compétences.</p>
        </a>
      </div>
    </section>

    <section class="editorial-section">
      <div class="section-label">Recherche</div>
      <div class="editorial-grid">
        <article class="editorial-card">
          <h3>Comprendre les sécheresses dans un climat en changement</h3>
          <p>Mon travail porte sur la prévisibilité des sécheresses en Europe, les régimes de circulation atmosphérique et leur évolution dans un climat modifié.</p>
        </article>
        <article class="editorial-card">
          <h3>Approche scientifique</h3>
          <p>J'étudie l'impact des grandes structures atmosphériques sur les déficits de précipitations et leur évolution sous le changement climatique.</p>
        </article>
      </div>
    </section>

    <section class="editorial-section">
      <div class="section-label">Publications</div>
      <div class="publication-list">
        {featured.filter(p => p.data.featured).map(p => (
          <article class="publication-item">
            <h3>{p.data.title}</h3>
            <div class="meta">{p.data.authors?.join(', ')} — {p.data.year}</div>
          </article>
        ))}
      </div>
    </section>
  </div>

</PageLayout>
