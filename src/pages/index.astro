---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const featured = await getCollection('publications');
---
<PageLayout title="Home" description="Onaïa Savary is a PhD student in climatology studying European droughts, atmospheric circulation and climate change.">
  <section id="banner" aria-label="Research introduction">
    <div class="inner">
      <p class="hero-kicker">PhD student in climatology</p>
      <h2>ONAÏA<br />SAVARY</h2>
      <p class="hero-intro">I study the predictability and evolution of European droughts, with a focus on the role of atmospheric circulation.</p>
      <ul class="actions special">
        <li><a href="#research" class="button primary scrolly">Explore my research</a></li>
      </ul>
    </div>
    <a href="#research" class="more scrolly">Explore</a>
  </section>

  <section id="research" class="wrapper style1 special">
    <div class="inner">
      <header class="major">
        <h2>Understanding droughts in a changing climate</h2>
        <p>My work examines European drought predictability, atmospheric circulation regimes, and how they evolve in a changing climate.</p>
      </header>
      <ul class="features">
        <li class="icon solid fa-cloud-sun"><h3>Predictability</h3><p>I study the conditions that make droughts more or less predictable.</p></li>
        <li class="icon solid fa-wind"><h3>Atmospheric circulation</h3><p>Large-scale atmospheric patterns play a central role in precipitation deficits.</p></li>
        <li class="icon solid fa-temperature-high"><h3>Changing climate</h3><p>These mechanisms are studied in the context of climate change.</p></li>
      </ul>
    </div>
  </section>

  <section id="topics" class="wrapper alt style2">
    <section class="spotlight">
      <div class="image"><img src="/images/article.png" alt="Illustration of climate research" /></div>
      <div class="content"><h2>Research</h2><p>I study how large-scale atmospheric patterns shape precipitation deficits and how this relationship may change with climate change.</p><a class="button" href="/research/">Research overview</a></div>
    </section>
    <section class="spotlight">
      <div class="image"><img src="/images/mt180.png" alt="Science communication presentation" /></div>
      <div class="content"><h2>Outreach</h2><p>Talks, podcasts and resources that bring climate science to wider audiences.</p><a class="button" href="/vulgarisation/">Explore outreach</a></div>
    </section>
  </section>

  <section id="access" class="wrapper style3 special">
    <div class="inner">
      <header class="major"><h2>Explore the site</h2><p>Find my academic background, conference contributions, posters and science communication work.</p></header>
      <ul class="features">
        <li class="icon solid fa-graduation-cap"><h3><a href="/cv/">Curriculum Vitae</a></h3><p>Education, experience and skills.</p></li>
        <li class="icon solid fa-comments"><h3><a href="/conferences/">Conferences</a></h3><p>Contributions to climate science meetings.</p></li>
        <li class="icon solid fa-images"><h3><a href="/posters/">Posters</a></h3><p>Visual summaries of research projects.</p></li>
        <li class="icon solid fa-user"><h3><a href="/about/">About</a></h3><p>Background and scientific activities.</p></li>
      </ul>
    </div>
  </section>

  <section id="cta" class="wrapper style4">
    <div class="inner">
      <header><h2>Get in touch</h2><p>For scientific questions, invitations or collaboration, feel free to get in touch.</p></header>
      <ul class="actions stacked"><li><a class="button fit primary" href="mailto:onaia.savary@ens-paris-saclay.fr">Contact me</a></li></ul>
    </div>
  </section>

  {featured.filter(p => p.data.featured).length > 0 && (
    <section class="wrapper style1 special home-featured">
      <div class="inner">
        <header class="major"><h2>Featured publication</h2></header>
        {featured.filter(p => p.data.featured).map(p => <p><a href={p.data.url}><strong>{p.data.title}</strong></a><br />{p.data.authors?.join(', ')} — {p.data.year}</p>)}
      </div>
    </section>
  )}
</PageLayout>
