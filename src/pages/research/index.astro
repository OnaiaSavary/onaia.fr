---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const pubs = await getCollection('publications');
---
<PageLayout title="Research" description="Research on European drought predictability, weather regimes and climate change.">
  <div class="site-wrap">
    <section class="read-width">
      <h1>Research</h1>
      <h2>Understanding droughts in a changing climate</h2>
      <p>My research focuses on the predictability and evolution of droughts in Europe, with an emphasis on atmospheric circulation and weather regimes.</p>
      <p>PhD project (title in the CV): "Drought predictability in a changing climate". The PhD investigates the link between large‑scale atmospheric circulation and precipitation deficits (droughts) in Europe, and studies the influence of climate change on this relationship.</p>

      <h3>Research themes</h3>
      <ol class="themes">
        <li>01 — Drought predictability</li>
        <li>02 — Weather regimes</li>
        <li>03 — Climate change</li>
      </ol>

      <h3>Selected publications</h3>
      <div class="list">
        {pubs.sort((a,b)=>b.data.year - a.data.year).slice(0,6).map(p=> (
          <div class="pub-item">
            <h4>{p.data.title}</h4>
            <div class="meta">{p.data.authors?.join(', ')} — {p.data.year}</div>
          </div>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
