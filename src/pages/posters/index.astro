---
import ContentPage from '../../components/ContentPage.astro';
---
<ContentPage title="Posters" description="Download research posters on European droughts and their predictability." image="/spectral/images/banner.jpg" intro="Research posters and downloadable conference material.">
      <div class="poster-list">
        <article class="editorial-item">
          <h2>MareNostrum Conference 2024</h2>
          <details class="media-disclosure">
            <summary>View poster (PDF)</summary>
            <p><a href="/posters/Poster_SAVARY_VF.pdf" download>Download poster (PDF)</a></p>
            <object class="pdf-preview" data="/posters/Poster_SAVARY_VF.pdf#view=FitH" type="application/pdf" aria-label="MareNostrum Conference 2024 poster preview">
              <p>PDF preview unavailable. <a href="/posters/Poster_SAVARY_VF.pdf">Open the poster PDF</a>.</p>
            </object>
          </details>
        </article>
        <article class="editorial-item">
          <h2>Linking european droughts to large-scale atmospheric circulation</h2>
          <details class="media-disclosure">
            <summary>View poster (PDF)</summary>
            <p><a href="/posters/Poster_JDD_compressed.pdf" download>Download poster (PDF)</a></p>
            <object class="pdf-preview" data="/posters/Poster_JDD_compressed.pdf#view=FitH" type="application/pdf" aria-label="Poster preview: Linking european droughts to large-scale atmospheric circulation">
              <p>PDF preview unavailable. <a href="/posters/Poster_JDD_compressed.pdf">Open the poster PDF</a>.</p>
            </object>
          </details>
        </article>
      </div>
</ContentPage>
